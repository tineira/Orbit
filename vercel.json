{
  "ignoreCommand": "echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -qF '[skip deploy]'",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tineira.com" }],
      "destination": "https://apc.tineira.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tineira.com" }],
      "destination": "https://apc.tineira.com/:path*",
      "permanent": true
    }
  ]
}
